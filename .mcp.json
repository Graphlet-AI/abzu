{
    "mcpServers": {
        "applescript-mcp": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "@peakmojo/applescript-mcp"
            ],
            "env": { }
        },
        "kuzu": {
            "command": "docker",
            "args": [
                "run",
                "-v",
                "/Users/rjurney/weave/data/kuzu/db:/database",
                "--rm",
                "-i",
                "kuzudb/mcp-server"
            ]
        },
        "github": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "-e",
                "GITHUB_PERSONAL_ACCESS_TOKEN",
                "ghcr.io/github/github-mcp-server"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": ""
            }
        },
        "passage-of-time-mcp": {
            "command": "npx",
            "args": [
                "mcp-remote",
                "https://localhost/sse",
                "--transport",
                "sse-only"
            ],
            "env": {
                "NODE_TLS_REJECT_UNAUTHORIZED": "0"
            }
        },
        "Bright Data": {
            "command": "npx",
            "args": [
                "mcp-remote",
                "https://mcp.brightdata.com/mcp?token=YOUR_API_TOKEN_HERE"
            ],
            "env": {
                "YOUR_API_TOKEN_HERE": ""
            }
        }
    }
}